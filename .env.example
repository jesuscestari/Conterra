# Copiar a .env y completar. El .env real no se commitea.
#
# Solo hacen falta para el plano de lotes de El Madrigal. El resto del sitio es
# estático y anda sin ninguna de estas.

# Base Postgres gestionada (Neon). Son dos cadenas distintas del mismo proyecto:
#
#   DATABASE_URL  conexión pooleada (el host lleva "-pooler"). La usan las
#                 funciones en tiempo de ejecución.
#   DIRECT_URL    conexión directa, sin pooler. La usa el CLI de Prisma para las
#                 migraciones, que necesitan una sesión propia.
#
# Para desarrollo local no hace falta Neon: `npm run db:local` levanta un
# Postgres en memoria y las dos apuntan ahí.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:55432/postgres"
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:55432/postgres"

# Firma las cookies de sesión del panel. Mínimo 32 caracteres.
# Generar una con: openssl rand -base64 36
SESSION_SECRET=""

# Primer administrador, que crea el seed. Si el email ya existe no se pisa la
# contraseña, así que volver a correr el seed no revierte un cambio de clave.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_NOMBRE=""
SEED_ADMIN_PASSWORD=""
